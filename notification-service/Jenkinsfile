pipeline {
    agent any

    environment {
        // ---- image ----
        IMAGE_NAME = "yogesh177/team-collab-notification-service"
        IMAGE_TAG  = "${BUILD_NUMBER}"

        // ---- dev server ----
        DEV_SERVER = "8.231.96.214"
        DEV_USER   = "yogeshbhatt"

        // ---- notification service ----
        APP_NAME = "notification-service-dev"
        NETWORK  = "dev-net"

        // ---- RabbitMQ ----
        RABBITMQ_NAME  = "rabbitmq-dev"
        RABBITMQ_IMAGE = "rabbitmq:4-management"
        RABBITMQ_HOST  = "rabbitmq-dev"
        RABBITMQ_PORT  = "5672"
        RABBITMQ_QUEUE = "notification.email.queue"

        // ---- Email ----
        EMAIL_HOST = "smtp.gmail.com"
        EMAIL_PORT = "587"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }


        stage('Build Image') {
            steps {
                dir('notification-service') {
                    sh """
                        docker build \
                          -t ${IMAGE_NAME}:${IMAGE_TAG} \
                          -t ${IMAGE_NAME}:develop-latest .
                    """
                }
            }
        }


        stage('Docker Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASS" | \
                        docker login -u "$DOCKER_USER" --password-stdin
                    '''
                }
            }
        }


        stage('Push Image') {
            steps {
                sh """
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:develop-latest
                """
            }
        }


        stage('Setup RabbitMQ') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'rabbitmq-dev-creds',
                        usernameVariable: 'RABBIT_USER',
                        passwordVariable: 'RABBIT_PASS'
                    )
                ]) {

                    sshagent(['deploy-server-key']) {

                        sh """
                            ssh -o StrictHostKeyChecking=no ${DEV_USER}@${DEV_SERVER} '

                                docker network inspect ${NETWORK} >/dev/null 2>&1 \
                                    || docker network create ${NETWORK}

                                if ! docker ps --format "{{.Names}}" \
                                    | grep -q "^${RABBITMQ_NAME}\$"; then

                                    docker rm -f ${RABBITMQ_NAME} 2>/dev/null || true

                                    docker run -d \
                                        --name ${RABBITMQ_NAME} \
                                        --network ${NETWORK} \
                                        --restart unless-stopped \
                                        -p 15672:15672 \
                                        -e RABBITMQ_DEFAULT_USER="${RABBIT_USER}" \
                                        -e RABBITMQ_DEFAULT_PASS="${RABBIT_PASS}" \
                                        ${RABBITMQ_IMAGE}
                                fi

                                until docker exec ${RABBITMQ_NAME} \
                                    rabbitmq-diagnostics -q ping
                                do
                                    sleep 3
                                done
                            '
                        """
                    }
                }
            }
        }


        stage('Deploy To Dev') {
            steps {

                withCredentials([

                    usernamePassword(
                        credentialsId: 'rabbitmq-dev-creds',
                        usernameVariable: 'RABBIT_USER',
                        passwordVariable: 'RABBIT_PASS'
                    ),

                    usernamePassword(
                        credentialsId: 'smtp-creds',
                        usernameVariable: 'EMAIL_USER',
                        passwordVariable: 'EMAIL_PASS'
                    )

                ]) {

                    sshagent(['deploy-server-key']) {

                        sh """
                            ssh -o StrictHostKeyChecking=no ${DEV_USER}@${DEV_SERVER} '

                                docker pull ${IMAGE_NAME}:develop-latest

                                docker stop ${APP_NAME} || true
                                docker rm ${APP_NAME} || true

                                docker run -d \
                                    --name ${APP_NAME} \
                                    --network ${NETWORK} \
                                    --restart unless-stopped \
                                    -e RabbitMQ__Host="${RABBITMQ_HOST}" \
                                    -e RabbitMQ__Port="${RABBITMQ_PORT}" \
                                    -e RabbitMQ__Username="${RABBIT_USER}" \
                                    -e RabbitMQ__Password="${RABBIT_PASS}" \
                                    -e RabbitMQ__Queue="${RABBITMQ_QUEUE}" \
                                    -e Email__Host="${EMAIL_HOST}" \
                                    -e Email__Port="${EMAIL_PORT}" \
                                    -e Email__Username="${EMAIL_USER}" \
                                    -e Email__Password="${EMAIL_PASS}" \
                                    -e Email__From="${EMAIL_USER}" \
                                    ${IMAGE_NAME}:develop-latest
                            '
                        """
                    }
                }
            }
        }
    }


    post {
        always {
            sh 'docker logout || true'
        }

        success {
            echo "notification-service ${BUILD_NUMBER} deployed to DEV."
        }

        failure {
            echo "notification-service ${BUILD_NUMBER} FAILED."
        }
    }
}