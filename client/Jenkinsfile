pipeline {
    agent any

    environment {
        // ---- image ----
        IMAGE_NAME = "yogesh177/team-collab-client"
        IMAGE_TAG  = "${BUILD_NUMBER}"          // unique per build (1, 2, 3 ...)

        // ---- inst2 (deploy server) ---- same GCP dev server as workspace-service
        DEV_SERVER = "8.231.96.214"
        DEV_USER   = "yogeshbhatt"

        // ---- dev container settings on inst2 ----
        APP_NAME   = "frontend"
        HOST_PORT  = "80"                        // browser reaches the app here

        // Backend dev API the built bundle must point at.
        // workspace-service is published on the same server at port 8082.
        BACKEND_URL = "http://8.231.96.214:8082"

        // auth-service is a separate backend published on the same server at port 8081.
        AUTH_URL = "http://8.231.96.214:8081"
    }

    stages {

        stage('Checkout') {
            steps { checkout scm }
        }

        // Vite bakes VITE_API_BASE_URL into the bundle at build time,
        // so the backend URL is passed as a build-arg (not a runtime env).
        stage('Build Image') {
            steps {
                dir('client') {
                    sh """
                    docker build \
                      --build-arg VITE_API_BASE_URL=${BACKEND_URL} \
                      --build-arg VITE_AUTH_BASE_URL=${AUTH_URL} \
                      -t ${IMAGE_NAME}:${IMAGE_TAG} \
                      -t ${IMAGE_NAME}:develop-latest .
                    """
                }
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS')]) {
                    sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'
                }
            }
        }

        stage('Push Image') {
            steps {
                sh """
                docker push ${IMAGE_NAME}:${IMAGE_TAG}
                docker push ${IMAGE_NAME}:develop-latest
                """
            }
        }


        stage('Deploy To Dev') {


            steps {
                sshagent(['deploy-server-key']) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ${DEV_USER}@${DEV_SERVER} '
                        docker pull ${IMAGE_NAME}:develop-latest

                        docker stop ${APP_NAME} || true
                        docker rm   ${APP_NAME} || true

                        docker run -d \
                            --name ${APP_NAME} \
                            -p ${HOST_PORT}:80 \
                            --restart unless-stopped \
                            ${IMAGE_NAME}:develop-latest
                    '
                    """
                }
            }
        }
    }

    post {
        always  { sh 'docker logout || true' }
        success { echo "client ${BUILD_NUMBER} deployed to DEV (port ${HOST_PORT})." }
        failure { echo "client ${BUILD_NUMBER} FAILED." }
    }
}
